<Window x:Class="LocalImageConverter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:LocalImageConverter.App.ViewModels"
        xmlns:models="clr-namespace:LocalImageConverter.Core.Models;assembly=LocalImageConverter.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        Title="Local Image Converter"
        Icon="Assets/app.ico"
        Width="1240" Height="840"
        MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, Inter, Roboto, Arial"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Footer / Actions Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER ================= -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentPrimary}" Margin="0,0,12,0">
                        <TextBlock Text="🖼" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LOCAL IMAGE CONVERTER" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimary}"/>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0.0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Conversión de imágenes 100% local, ultrarrápida y privada" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Privacy Badge in Center -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="20" Padding="14,6" Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="100 % LOCAL — Tus imágenes nunca salen de tu computadora" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Top Right Utilities -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenLogsFolderCommand}" ToolTip="Abrir carpeta local de registros" Margin="0,0,8,0" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,5,0"/>
                            <TextBlock Text="Logs" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearListCommand}" IsEnabled="{Binding HasItems}" ToolTip="Vaciar lista de imágenes" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑" Margin="0,0,5,0"/>
                            <TextBlock Text="Limpiar" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN BODY (2 COLUMNS) ================= -->
        <Grid Grid.Row="1" Margin="20,16">
            <Grid.ColumnDefinitions>
                <!-- Left: File List & Drop Zone (58%) -->
                <ColumnDefinition Width="6*" MinWidth="480"/>
                <!-- Splitter -->
                <ColumnDefinition Width="16"/>
                <!-- Right: Options Panel (42%) -->
                <ColumnDefinition Width="4*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT COLUMN: FILES / DROP ZONE ================= -->
            <Grid Grid.Column="0">
                <!-- VIEW A: EMPTY STATE DROP ZONE -->
                <Border Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisConverter}}"
                        Style="{StaticResource CardStyle}"
                        BorderBrush="{StaticResource AccentPrimary}"
                        BorderThickness="2"
                        Cursor="Hand"
                        MouseLeftButtonDown="DropZone_MouseLeftButtonDown">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#101726" Offset="0"/>
                            <GradientStop Color="#151E2E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                            <!-- Icon -->
                            <Border Width="80" Height="80" CornerRadius="40" Background="#1E293B" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="📁" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Arrastrá imágenes o carpetas aquí" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Soporta JPG, PNG, WebP, AVIF, BMP, TIFF, GIF, ICO y HEIC" FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>

                            <!-- Action Buttons inside Dropzone -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddFilesCommand}" Margin="0,0,12,0" Padding="18,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Añadir imágenes" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddFolderCommand}" Padding="18,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📂" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Añadir carpeta" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Subfolder Search Checkbox -->
                            <CheckBox IsChecked="{Binding ScanSubfolders}" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12">
                                <TextBlock Text="Buscar automáticamente en subcarpetas al arrastrar carpetas" Margin="4,0,0,0"/>
                            </CheckBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- VIEW B: POPULATED FILES LIST -->
                <Grid Visibility="{Binding HasItems, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.RowDefinitions>
                        <!-- List Top Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Scrollable File Items -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar with Counts and Add More -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1,1,1,0" CornerRadius="12,12,0,0" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalSummaryText}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddFilesCommand}" Padding="10,5" Margin="0,0,6,0">
                                    <TextBlock Text="+ Imágenes" FontSize="12"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddFolderCommand}" Padding="10,5">
                                    <TextBlock Text="+ Carpeta" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- File Items List -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="0,0,12,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewmodels:ImageItemViewModel}">
                                        <Border BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="0,0,0,1" Padding="12,10" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Thumbnail -->
                                                    <ColumnDefinition Width="48"/>
                                                    <!-- Name and Details -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- Resolution & Input Size -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- Status Badge & Result -->
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- Delete Button -->
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Thumbnail Image -->
                                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="6" Background="#1E293B" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" ClipToBounds="True">
                                                    <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill"/>
                                                </Border>

                                                <!-- Name & Path -->
                                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <Border Background="#334155" CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding FileExtension}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextHighlight}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding DimensionsFormatted}" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Input Size -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding FileSizeFormatted}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/>
                                                </StackPanel>

                                                <!-- Status Badge / Result -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0" MinWidth="110" HorizontalAlignment="Right">
                                                    <Border CornerRadius="12" Padding="8,3" Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding StatusDisplayText}" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding SavingsDisplayText}" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" Margin="0,2,0,0" HorizontalAlignment="Right"
                                                               Visibility="{Binding ConvertedFileSizeBytes, Converter={StaticResource NullToVisConverter}}"/>
                                                </StackPanel>

                                                <!-- Delete button -->
                                                <Button Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="4" Width="28" Height="28" HorizontalAlignment="Center" ToolTip="Quitar de la lista">
                                                    <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================= RIGHT COLUMN: OPTIONS & SETTINGS ================= -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Quick Presets -->
                        <TextBlock Text="PRESETS RÁPIDOS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextHighlight}" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,14">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ApplyPresetCommand}" CommandParameter="{Binding AvailablePresets[0]}" Margin="0,0,6,6" Padding="10,6">
                                <TextBlock Text="🌐 Web Equilibrado" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ApplyPresetCommand}" CommandParameter="{Binding AvailablePresets[1]}" Margin="0,0,6,6" Padding="10,6">
                                <TextBlock Text="📸 JPEG HD" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ApplyPresetCommand}" CommandParameter="{Binding AvailablePresets[2]}" Margin="0,0,6,6" Padding="10,6">
                                <TextBlock Text="✨ PNG Sin Pérdida" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ApplyPresetCommand}" CommandParameter="{Binding AvailablePresets[3]}" Margin="0,0,6,6" Padding="10,6">
                                <TextBlock Text="⚡ Reducir Tamaño" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            </Button>
                        </WrapPanel>

                        <Border Height="1" Background="{StaticResource SurfaceBorder}" Margin="0,0,0,14"/>

                        <!-- 1. Target Format Selection -->
                        <TextBlock Text="FORMATO DE SALIDA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextHighlight}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding SelectedFormat}"
                                  Margin="0,0,0,16">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ImageFormatDefinition}">
                                    <StackPanel Orientation="Horizontal" Margin="2,1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="10,2,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- 2. Quality Slider (Lossy only) -->
                        <StackPanel Visibility="{Binding ShowQualityControl, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,16">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="CALIDAD DE COMPRESIÓN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextHighlight}"/>
                                <TextBlock Text="{Binding Quality, StringFormat='{}{0} %'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Minimum="1" Maximum="100" Value="{Binding Quality}" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="5"/>
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="1 (Máx compresión)" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="Recomendado: 82-90" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Center"/>
                                <TextBlock Text="100 (Máx calidad)" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <!-- 3. Transparency Background Solid Fill (For formats without Alpha) -->
                        <StackPanel Visibility="{Binding ShowAlphaBackgroundControl, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,16">
                            <TextBlock Text="FONDO PARA TRANSPARENCIAS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextHighlight}" Margin="0,0,0,6"/>
                            <TextBlock Text="El formato elegido no soporta transparencia (alpha)." FontSize="11" Foreground="{StaticResource AccentWarning}" Margin="0,0,0,6"/>
                            <ComboBox SelectedValue="{Binding SelectedAlphaBackground}" SelectedValuePath="Tag" FontSize="12">
                                <ComboBoxItem Content="⚪ Blanco (Recomendado)" Tag="{x:Static models:AlphaBackgroundColor.White}" IsSelected="True"/>
                                <ComboBoxItem Content="⚫ Negro" Tag="{x:Static models:AlphaBackgroundColor.Black}"/>
                                <ComboBoxItem Content="🎨 Personalizado (Hex)" Tag="{x:Static models:AlphaBackgroundColor.CustomHex}"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- 4. Resize Options -->
                        <TextBlock Text="REDIMENSIONAMIENTO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextHighlight}" Margin="0,0,0,8"/>
                        <ComboBox SelectedValue="{Binding SelectedResizeMode}" SelectedValuePath="Tag" FontSize="12" Margin="0,0,0,10">
                            <ComboBoxItem Content="Mantener resolución original" Tag="{x:Static models:ResizeMode.KeepOriginal}" IsSelected="True"/>
                            <ComboBoxItem Content="Ajustar a resolución máxima (Aspect Ratio)" Tag="{x:Static models:ResizeMode.MaxDimension}"/>
                            <ComboBoxItem Content="Personalizado (Ancho / Alto)" Tag="{x:Static models:ResizeMode.CustomDimensions}"/>
                        </ComboBox>

                        <!-- Max dimension preset selector -->
                        <StackPanel Visibility="{Binding ShowMaxDimensionDropdown, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,14">
                            <TextBlock Text="Dimensión máxima permitida:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding SelectedMaxDimension}" SelectedValuePath="Tag" FontSize="12">
                                <ComboBoxItem Content="4K Ultra HD (3840 px)" Tag="3840"/>
                                <ComboBoxItem Content="2K QHD (2560 px)" Tag="2560"/>
                                <ComboBoxItem Content="Full HD (1920 px)" Tag="1920" IsSelected="True"/>
                                <ComboBoxItem Content="Web Grande (1600 px)" Tag="1600"/>
                                <ComboBoxItem Content="HD Ready (1280 px)" Tag="1280"/>
                                <ComboBoxItem Content="Web Compacto (800 px)" Tag="800"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Custom width/height inputs -->
                        <StackPanel Visibility="{Binding ShowCustomResizeInputs, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,14">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ancho (px)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding CustomWidth, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Alto (px)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding CustomHeight, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox IsChecked="{Binding KeepAspectRatio}" Content="Mantener proporción de aspecto" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource SurfaceBorder}" Margin="0,4,0,16"/>

                        <!-- 5. Destination Folder -->
                        <TextBlock Text="CARPETA DE DESTINO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextHighlight}" Margin="0,0,0,8"/>
                        <ComboBox SelectedValue="{Binding SelectedOutputMode}" SelectedValuePath="Tag" FontSize="12" Margin="0,0,0,8">
                            <ComboBoxItem Content="📁 Subcarpeta 'Converted' junto a originales" Tag="{x:Static models:OutputDirectoryMode.ConvertedSubfolder}" IsSelected="True"/>
                            <ComboBoxItem Content="📂 Seleccionar carpeta fija personalizada" Tag="{x:Static models:OutputDirectoryMode.CustomFolder}"/>
                            <ComboBoxItem Content="📄 Misma carpeta que las imágenes originales" Tag="{x:Static models:OutputDirectoryMode.SameFolderAsOriginal}"/>
                        </ComboBox>

                        <!-- Custom Destination input and browse button -->
                        <Grid Visibility="{Binding ShowCustomFolderInput, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding CustomOutputFolder, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="12" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseCustomOutputFolderCommand}" Content="Examinar..." Padding="10,6" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource SurfaceBorder}" Margin="0,4,0,16"/>

                        <!-- 6. Advanced Settings Expander -->
                        <Expander Header="⚙️ Configuración avanzada" IsExpanded="{Binding IsAdvancedSettingsExpanded}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold">
                            <StackPanel Margin="0,10,0,0">
                                <!-- Metadata stripping -->
                                <TextBlock Text="METADATOS &amp; PRIVACIDAD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextHighlight}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding SelectedMetadataOption}" SelectedValuePath="Tag" FontSize="11" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Conservar todos los metadatos" Tag="{x:Static models:MetadataOption.KeepAll}" IsSelected="True"/>
                                    <ComboBoxItem Content="🛡️ Eliminar datos privados (GPS, cámara) - Preservar color" Tag="{x:Static models:MetadataOption.StripPrivateGpsExif}"/>
                                    <ComboBoxItem Content="Eliminar toda la metadata (Mínimo tamaño)" Tag="{x:Static models:MetadataOption.StripAll}"/>
                                </ComboBox>

                                <!-- Collision policy -->
                                <TextBlock Text="EN CASO DE ARCHIVOS DUPLICADOS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextHighlight}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding SelectedConflictResolution}" SelectedValuePath="Tag" FontSize="11" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Renombrar automáticamente (_1, _2)" Tag="{x:Static models:ConflictResolution.AutoRename}" IsSelected="True"/>
                                    <ComboBoxItem Content="Sobrescribir archivo existente" Tag="{x:Static models:ConflictResolution.Overwrite}"/>
                                    <ComboBoxItem Content="Saltar archivo" Tag="{x:Static models:ConflictResolution.Skip}"/>
                                </ComboBox>

                                <!-- Concurrency -->
                                <TextBlock Text="CONVERSIONES SIMULTÁNEAS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextHighlight}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding MaxConcurrency}" SelectedValuePath="Tag" FontSize="11">
                                    <ComboBoxItem Content="Automático (Recomendado según CPU)" Tag="4" IsSelected="True"/>
                                    <ComboBoxItem Content="1 archivo simultáneo (Bajo consumo)" Tag="1"/>
                                    <ComboBoxItem Content="2 archivos simultáneos" Tag="2"/>
                                    <ComboBoxItem Content="4 archivos simultáneos" Tag="4"/>
                                    <ComboBoxItem Content="8 archivos simultáneos" Tag="8"/>
                                </ComboBox>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= BOTTOM ACTION & PROGRESS BAR ================= -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Status or Completed Summary -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Big Action Button / Cancel -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status & Progress Left Area -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{Binding StatusHeader}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>

                    <!-- Progress Bar (Visible when Converting) -->
                    <ProgressBar Height="6" Maximum="100" Value="{Binding OverallProgressPercentage}" Margin="0,8,0,0"
                                 Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisConverter}}"
                                 Foreground="{StaticResource AccentCyan}" Background="#1E293B" BorderThickness="0"/>
                </StackPanel>

                <!-- Actions Right Area -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Open Output Folder Button (When batch is completed) -->
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenOutputFolderCommand}"
                            Visibility="{Binding HasCompletedBatch, Converter={StaticResource BoolToVisConverter}}"
                            Margin="0,0,12,0" Padding="16,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Abrir carpeta de salida" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Cancel Button (When converting) -->
                    <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding CancelConversionCommand}"
                            Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisConverter}}"
                            Padding="20,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏹" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cancelar"/>
                        </StackPanel>
                    </Button>

                    <!-- Convert CTA Button (When not converting) -->
                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartConversionCommand}"
                            IsEnabled="{Binding HasItems}"
                            Visibility="{Binding IsConverting, Converter={StaticResource InverseBoolToVisConverter}}"
                            Padding="24,12" FontSize="14">
                        <Button.Background>
